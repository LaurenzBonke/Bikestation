{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Bikestation": "Data Source=bikestation.db"
  },
  "Occupancy": {
    "PressureThreshold": 500,
    "TamperAlertCooldownSeconds": 60,
    "AnomalyAlertCooldownSeconds": 300
  },
  "Box": {
    "BikePresentMaxDistanceCm": 7,
    "ParkConfirmSeconds": 5,
    "LeaveConfirmSeconds": 5,
    "AlarmConfirmSeconds": 3,
    "OpenForParkingTimeoutSeconds": 120,
    "OpenForPickupTimeoutSeconds": 120
  },
  "Anomaly": {
    "Enabled": true,
    "IntervalSeconds": 10,
    "ZThreshold": 6,
    "HistorySize": 2000,
    "MinSamples": 30
  },
  "Retention": {
    "ReadingDays": 90
  },
  "Devices": {
    "ApiKey": "",
    "OfflineAfterSeconds": 30
  },
  "Jwt": {
    "Issuer": "bikestation-api",
    "Audience": "bikestation-dashboard",
    "Key": "",
    "ExpiresMinutes": 60,
    "UserExpiresMinutes": 720
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
