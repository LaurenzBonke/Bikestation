# systemd-Dienst: startet den Bikestation-Agenten beim Hochfahren und nach Abstürzen neu.
# Installation: siehe install.sh (ersetzt __USER__ und __DIR__)
[Unit]
Description=Bikestation-Agent (Sensoren, Servo-Riegel, Verbindung zur API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=/usr/bin/python3 __DIR__/bikestation_agent.py --config __DIR__/config.ini
Restart=always
RestartSec=5
# Zugriff auf die GPIO-Pins
SupplementaryGroups=gpio

[Install]
WantedBy=multi-user.target
